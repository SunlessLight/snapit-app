# Backend API base URL. Match the port Express is listening on.
VITE_API_BASE_URL=http://localhost:3000

# Supabase Auth. Grab these from Supabase Dashboard → Project Settings → API.
# Use the *publishable* (anon) key — never paste the service-role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Phase 6.7.5 — flag-gates the mask-preview checkpoint between Context Config
# and Processing. On by default — it's the vendor-facing cutout check before
# the expensive generate. Set false only to fall back to the 6-step flow.
VITE_ENABLE_MASK_PREVIEW=true
